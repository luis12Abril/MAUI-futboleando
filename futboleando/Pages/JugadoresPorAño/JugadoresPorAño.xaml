<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:entities="clr-namespace:futboleandoEntities.JugadoresPorAño;assembly=futboleandoEntities"
             x:Class="futboleando.Pages.JugadoresPorAño.JugadoresPorAñoPage"
             Title="Jugadores por Año"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        
        <!-- ========== ENCABEZADO ========== -->
        <Grid Grid.Row="0"
              Padding="1,2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource azulOscuro}" Offset="0.0" />
                    <GradientStop Color="{StaticResource verdeOscuro}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="6,4"
                        Margin="0,-8,0,0"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding NombreTorneoSeleccionado}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Opacity="0.95"
                           Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- ========== FILTRO POR EQUIPO ========== -->
        <Frame Grid.Row="1"
               Padding="10"
               CornerRadius="10"
               BackgroundColor="White"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="15,0,15,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0"
                        StrokeThickness="1"
                        Stroke="{StaticResource verdeOscuro}"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F8F9FA">
                    <Picker x:Name="pickerEquipo"
                            Title="-- SELECCIONE UN EQUIPO --"
                            ItemsSource="{Binding listaequipos}"
                            ItemDisplayBinding="{Binding nombre}"
                            SelectedItem="{Binding equipoSeleccionado}"
                            SelectedIndexChanged="OnEquipoSelected"
                            FontSize="14"
                            TextColor="{StaticResource verdeOscuro}"
                            TitleColor="#6c757d"
                            BackgroundColor="Transparent"
                            Margin="8,3" />
                </Border>
                <Button Grid.Column="1"
                        Text="✕"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="{StaticResource rojoOscuro}"
                        CornerRadius="8"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        Clicked="OnLimpiarFiltroClicked"
                        ToolTipProperties.Text="Limpiar filtro" />
            </Grid>
        </Frame>

        <!-- ========== TOTALES ========== -->
        <Frame Grid.Row="2"
               Padding="15,12"
               CornerRadius="12"
               HasShadow="True"
               BorderColor="Transparent"
               BackgroundColor="{StaticResource verdeOscuro}"
               Margin="15,0,15,10">

            <Grid ColumnDefinitions="*,Auto,*"
                  ColumnSpacing="15">
                <Label Grid.Column="0"
                       Text="AÑO"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#E6FFEF"
                       HorizontalOptions="Start"
                       VerticalOptions="Center" />
                
                <BoxView Grid.Column="1"
                         Color="#C7F9CC"
                         WidthRequest="2"
                         HeightRequest="25" />
                
                <HorizontalStackLayout Grid.Column="2"
                                     Spacing="8"
                                     HorizontalOptions="End">
                    <Label Text="TOTAL:"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#E6FFEF"
                           VerticalOptions="Center" />
                    <Label x:Name="lblTotalJugadores"
                           Text="0"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Frame>

        <!-- ========== LISTA DE AÑOS ========== -->
        <Grid Grid.Row="3">
            <!-- Indicador de carga -->
            <ActivityIndicator x:Name="loadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{StaticResource azulOscuro}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             HeightRequest="50"
                             WidthRequest="50" />
            
            <CollectionView x:Name="collectionJugadoresPorAño"
                            ItemsSource="{Binding listajugadoresporaño}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem"
                            Margin="15,0,15,15">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:JugadoresPorAñoCLS">
                        <Frame Padding="20,15"
                               CornerRadius="15"
                               BackgroundColor="White"
                               HasShadow="True"
                               BorderColor="Transparent"
                               Margin="0">
                            
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="20">
                                
                                 <Label Grid.Column="0"
                                        Text="{Binding Anio}"
                                        FontSize="24"
                                        FontAttributes="Bold"
                                        TextColor="#0F172A"
                                        LineBreakMode="WordWrap"
                                        MaxLines="2"
                                        HorizontalOptions="FillAndExpand"
                                        HorizontalTextAlignment="Start"
                                        VerticalOptions="Start"
                                        Margin="0,4,0,0"
                                        ZIndex="1" />
                                
                                <Frame Grid.Column="1"
                                       WidthRequest="60"
                                       HeightRequest="60"
                                       CornerRadius="30"
                                       Padding="0"
                                       HasShadow="False"
                                       BackgroundColor="{StaticResource verdeOscuro}"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding cantidad}"
                                           FontSize="26"
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center">
                        <Label Text="📅"
                               FontSize="60"
                               HorizontalOptions="Center"
                               Opacity="0.3" />
                        <Label Text="No hay jugadores registrados"
                               FontSize="16"
                               TextColor="#999999"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
                        <Label Text="Seleccione otro equipo o verifique el torneo"
                               FontSize="13"
                               TextColor="#CCCCCC"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

    </Grid>
</ContentPage>