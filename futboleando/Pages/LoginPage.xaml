<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.LoginPage"
             Title="LoginPage">
    <VerticalStackLayout Margin="10" VerticalOptions="Center">
        <Label Text="Ingrese usuario:" Style="{StaticResource estiloLabel}" />
        <Entry  Text="{Binding oLoginCLS.nombreusuario}" Style="{StaticResource estiloEntry}" />
        <Label Text="Ingrese contraseña:" Style="{StaticResource estiloLabel}" />
        <Entry Text="{Binding oLoginCLS.contra}"  Style="{StaticResource estiloPassword}"   />
        <Button x:Name="btnIngresar" Clicked="btnIngresar_Clicked"  Text="Ingresar" Style="{StaticResource botonVerde}" />
    </VerticalStackLayout>
</ContentPage>