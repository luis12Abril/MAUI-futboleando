<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.Registro.RegistroPage"
             Title="Registro de Usuario"
             BackgroundColor="#F5F5F5">

    <Grid>
        <!-- Fondo degradado -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource azulOscuro}" Offset="0.0" />
                <GradientStop Color="{StaticResource rojoOscuro}" Offset="0.5" />
                <GradientStop Color="#1a1a1a" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,10" 
                                 VerticalOptions="Start"
                                 Spacing="0">

                <!-- ========== TARJETA DE REGISTRO ========== -->
                <Frame Padding="25"
                       CornerRadius="20"
                       BackgroundColor="White"
                       HasShadow="True"
                       BorderColor="Transparent"
                       Margin="0,0,0,16">
                    
                    <Frame.Shadow>
                        <Shadow Brush="Black" 
                                Opacity="0.3" 
                                Radius="15" 
                                Offset="0,5" />
                    </Frame.Shadow>

                    <VerticalStackLayout Spacing="20">
                        
                        <!-- Título de la tarjeta -->
                        <Label Text="Datos de Registro"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="{StaticResource azulOscuro}"
                               HorizontalOptions="Center"
                               Margin="0,0,0,10" />

                        <!-- Campo de Usuario -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Nombre de Usuario"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#424242" />
                            
                            <Frame Padding="0"
                                   CornerRadius="10"
                                   BorderColor="{StaticResource azulOscuro}"
                                   HasShadow="False"
                                   BackgroundColor="Transparent">
                                
                                <Border StrokeThickness="2"
                                        Stroke="{StaticResource azulOscuro}"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="White">
                                    
                                    <Grid ColumnDefinitions="Auto,*" 
                                          Padding="12,8">
                                        
                                        <Label Text="👤" 
                                               FontSize="20"
                                               VerticalOptions="Center"
                                               Margin="0,0,10,0" />
                                        
                                        <Entry x:Name="txtUsuario"
                                               Grid.Column="1"
                                               Text="{Binding oRegistroRequestCLS.nombreusuario}"
                                               Placeholder="Elige un nombre de usuario"
                                               FontSize="16"
                                               TextColor="#000000"
                                               PlaceholderColor="#999999"
                                               BackgroundColor="Transparent" />
                                    </Grid>
                                </Border>
                            </Frame>
                            
                            <Label Text="Mínimo 1 caracter"
                                   FontSize="11"
                                   TextColor="#666666"
                                   Opacity="0.7"
                                   Margin="5,0,0,0" />
                        </VerticalStackLayout>

                        <!-- Campo de Contraseña -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Contraseña"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#424242" />
                            
                            <Frame Padding="0"
                                   CornerRadius="10"
                                   BorderColor="{StaticResource rojoOscuro}"
                                   HasShadow="False"
                                   BackgroundColor="Transparent">
                                
                                <Border StrokeThickness="2"
                                        Stroke="{StaticResource rojoOscuro}"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="White">
                                    
                                    <Grid ColumnDefinitions="Auto,*" 
                                          Padding="12,8">
                                        
                                        <Label Text="🔒" 
                                               FontSize="20"
                                               VerticalOptions="Center"
                                               Margin="0,0,10,0" />
                                        
                                        <Entry x:Name="txtPassword"
                                               Grid.Column="1"
                                               Text="{Binding oRegistroRequestCLS.contra}"
                                               Placeholder="Crea una contraseña segura"
                                               IsPassword="True"
                                               FontSize="16"
                                               TextColor="#000000"
                                               PlaceholderColor="#999999"
                                               BackgroundColor="Transparent" />
                                    </Grid>
                                </Border>
                            </Frame>
                            
                            <Label Text="Mínimo 1 caracter"
                                   FontSize="11"
                                   TextColor="#666666"
                                   Opacity="0.7"
                                   Margin="5,0,0,0" />
                        </VerticalStackLayout>

                        <!-- Campo de Confirmar Contraseña -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Confirmar Contraseña"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#424242" />
                            
                            <Frame Padding="0"
                                   CornerRadius="10"
                                   BorderColor="{StaticResource rojoOscuro}"
                                   HasShadow="False"
                                   BackgroundColor="Transparent">
                                
                                <Border StrokeThickness="2"
                                        Stroke="{StaticResource rojoOscuro}"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="White">
                                    
                                    <Grid ColumnDefinitions="Auto,*" 
                                          Padding="12,8">
                                        
                                        <Label Text="🔐" 
                                               FontSize="20"
                                               VerticalOptions="Center"
                                               Margin="0,0,10,0" />
                                        
                                        <Entry x:Name="txtConfirmPassword"
                                               Grid.Column="1"
                                               Placeholder="Confirma tu contraseña"
                                               IsPassword="True"
                                               FontSize="16"
                                               TextColor="#000000"
                                               PlaceholderColor="#999999"
                                               BackgroundColor="Transparent" />
                                    </Grid>
                                </Border>
                            </Frame>
                        </VerticalStackLayout>

                        <!-- Botón de Registrarse -->
                        <Button x:Name="btnRegistrar" 
                                Clicked="btnRegistrarse_Clicked"  
                                Text="REGISTRARSE"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="White"
                                BackgroundColor="{StaticResource verdeOscuro}"
                                CornerRadius="12"
                                HeightRequest="55"
                                Margin="0,15,0,0">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource verdeOscuro}" 
                                        Opacity="0.4" 
                                        Radius="8" 
                                        Offset="0,4" />
                            </Button.Shadow>
                        </Button>

                        <!-- Línea separadora con texto -->
                        <Grid ColumnDefinitions="*,Auto,*" 
                              Margin="0,10,0,0">
                            <BoxView Grid.Column="0"
                                     Color="#E0E0E0"
                                     HeightRequest="1"
                                     VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="o"
                                   FontSize="12"
                                   TextColor="#999999"
                                   Margin="10,0" />
                            <BoxView Grid.Column="2"
                                     Color="#E0E0E0"
                                     HeightRequest="1"
                                     VerticalOptions="Center" />
                        </Grid>

                        <!-- Opción de volver al login -->
                        <HorizontalStackLayout HorizontalOptions="Center"
                                               Spacing="5">
                            <Label Text="¿Ya tienes cuenta?"
                                   FontSize="13"
                                   TextColor="#666666"
                                   VerticalOptions="Center" />
                            <Label Text="Inicia sesión"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource azulOscuro}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVolverLoginTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Frame>

                <!-- ========== PIE DE PÁGINA ========== -->
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center">
                    <Label Text="© 2026 Futboleando"
                           FontSize="12"
                           TextColor="White"
                           Opacity="0.7"
                           HorizontalOptions="Center" />
                    <Label Text="v2.0.0"
                           FontSize="10"
                           TextColor="White"
                           Opacity="0.5"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>