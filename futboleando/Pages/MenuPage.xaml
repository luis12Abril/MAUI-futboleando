<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.MenuPage"
             Title="MenuPage">
    <VerticalStackLayout Margin="10">
        <ListView SelectedItem="{Binding oMenuCLS}" 
               x:Name="lstMenu" ItemTapped="lstMenu_ItemTapped"  ItemsSource="{Binding listamenu}" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!--<TextCell Text="{Binding nombreopcion}" />-->
                    <ViewCell>
                        <Label Style="{StaticResource estiloLabel}" Text="{Binding nombreopcion}" />
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>