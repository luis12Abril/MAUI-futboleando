<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.Ciudad.CiudadFormPage"
             Title="Formulario Ciudad">
    <VerticalStackLayout Style="{StaticResource verticalStackLayoutPage}" Margin="10">
        <Label Text="Ingrese Ciudad: " Style="{StaticResource estiloLabel}"/>
        <Entry Text="{Binding oCiudadModel.oCiudadFormCLS.nombreciudad}"/>
        <Label Text="Ingrese Descripción: " Style="{StaticResource estiloLabel}"/>
        <Editor HeightRequest="100" Text="{Binding oCiudadModel.oCiudadFormCLS.descripcion}"/>

        <StackLayout Style="{StaticResource estiloStackLayoutButton}">
            <Button x:Name="btnGuardar" Text="Guardar"  Style="{StaticResource botonVerde}" Clicked="btnGuardar_Clicked"/>
            <Button x:Name="btnCancelar" Text="Cancelar" Style="{StaticResource botonRojo}" Clicked="btnCancelar_Clicked"/>
        </StackLayout>
    </VerticalStackLayout>
</ContentPage>