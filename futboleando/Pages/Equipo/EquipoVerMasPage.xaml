<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:futboleando.Converters"
             xmlns:entities="clr-namespace:futboleandoEntities.Juego;assembly=futboleandoEntities"
             x:Class="futboleando.Pages.Equipo.EquipoVerMasPage"
             Title="Juegos del Equipo"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EstatusJuegoToColorConverter x:Key="EstatusToColor" />
            <converters:EstatusJuegoToTextColorConverter x:Key="EstatusToTextColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Encabezado -->
        <Grid Grid.Row="0"
              Padding="1,2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource azulOscuro}" Offset="0.0" />
                    <GradientStop Color="{StaticResource verdeOscuro}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="6,4"
                        Margin="0,-8,0,0"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding NombreEquipoSeleccionado}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Opacity="0.95"
                           Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- Lista de juegos -->
        <Grid Grid.Row="1">
            <ActivityIndicator x:Name="loadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{StaticResource azulOscuro}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HeightRequest="50"
                               WidthRequest="50" />

            <CollectionView ItemsSource="{Binding listajuegos}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureAllItems"
                            Margin="15,0,15,15">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:JuegoListCLS">
                        <Border StrokeThickness="3"
                                Stroke="{StaticResource verdeOscuro}"
                                StrokeShape="RoundRectangle 15"
                                Margin="0,5"
                                BackgroundColor="Transparent">

                            <Frame Padding="0"
                                   CornerRadius="15"
                                   HasShadow="True"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding nombreestatusjuego, Converter={StaticResource EstatusToColor}}"
                                   Margin="0">

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      Padding="18,18,18,22">

                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0"
                                               Text="{Binding nombrejornada}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{Binding nombreestatusjuego, Converter={StaticResource EstatusToTextColor}}"
                                               HorizontalOptions="Start"
                                               Margin="0,0,0,10" />
                                        <Label Grid.Column="1"
                                               Text="{Binding nombreestatusjuego}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{Binding nombreestatusjuego, Converter={StaticResource EstatusToTextColor}}"
                                               HorizontalOptions="End"
                                               Margin="0,0,0,10" />
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="2*,Auto,2*"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="15"
                                          RowSpacing="10">

                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding nombreequipo01}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               LineBreakMode="WordWrap"
                                               MaxLines="2"
                                               HorizontalOptions="FillAndExpand"
                                               HorizontalTextAlignment="End"
                                               VerticalOptions="Start"
                                               Margin="0,4,0,0"
                                               ZIndex="1" />

                                        <Frame Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                               Padding="15,10"
                                               CornerRadius="12"
                                               BackgroundColor="#F0F0F0"
                                               HasShadow="False"
                                               VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding golesequipo01}"
                                                       FontSize="24"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource azulOscuro}"
                                                       VerticalOptions="Center" />
                                                <Label Text="-"
                                                       FontSize="20"
                                                       FontAttributes="Bold"
                                                       TextColor="#999999"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding golesequipo02}"
                                                       FontSize="24"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource verdeOscuro}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Frame>

                                        <Label Grid.Row="0" Grid.Column="2"
                                               Text="{Binding nombreequipo02}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               LineBreakMode="WordWrap"
                                               MaxLines="2"
                                               HorizontalOptions="FillAndExpand"
                                               HorizontalTextAlignment="Start"
                                               VerticalOptions="Start"
                                               Margin="0,4,0,0"
                                               ZIndex="1" />
                                    </Grid>

                                    <BoxView Grid.Row="2"
                                             Color="#E0E0E0"
                                             HeightRequest="1"
                                             Margin="0,12" />

                                    <Grid Grid.Row="3"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="10"
                                          RowSpacing="8">

                                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                            <Label Text="📅"
                                                   FontSize="16"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding fhorario, StringFormat='{0:dd/MM/yyyy}'}"
                                                   FontSize="13"
                                                   TextColor="#666666"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                            <Label Text="🕐"
                                                   FontSize="16"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding fhorario, StringFormat='{0:hh:mm tt}'}"
                                                   FontSize="13"
                                                   TextColor="#666666"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Grid Grid.Row="4"
                                          ColumnDefinitions="*,*"
                                          Margin="0,8,0,0">

                                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                            <Label Text="🏟️"
                                                   FontSize="16"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding nombrecampo}"
                                                   FontSize="13"
                                                   TextColor="#666666"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Start">
                                            <Label Text="🧑‍⚖️"
                                                   FontSize="16"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding nombrearbitro}"
                                                   FontSize="13"
                                                   TextColor="#666666"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                </Grid>
                            </Frame>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center">
                        <Label Text="⚽"
                               FontSize="60"
                               HorizontalOptions="Center"
                               Opacity="0.3" />
                        <Label Text="No hay juegos para este equipo"
                               FontSize="16"
                               TextColor="#999999"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
                        <Label Text="El equipo no tiene juegos registrados"
                               FontSize="13"
                               TextColor="#CCCCCC"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <Frame Grid.Row="2"
               Padding="12"
               CornerRadius="0"
               BackgroundColor="{StaticResource verdeOscuro}"
               HasShadow="False"
               BorderColor="Transparent">
            <Label Text="{Binding TotalJuegosTexto}"
                   FontSize="12"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Frame>
    </Grid>
</ContentPage>
