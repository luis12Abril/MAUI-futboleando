<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:futboleando.Models"
             x:Class="futboleando.Pages.EquipoPage"
             Title="Equipos"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">
    
    <Grid RowDefinitions="Auto,*,Auto" Padding="0">
        
        <!-- Encabezado -->
        <Grid Grid.Row="0" 
              Padding="1,2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource azulOscuro}" Offset="0.0" />
                    <GradientStop Color="{StaticResource verdeOscuro}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="6,4"
                        Margin="0,-8,0,0"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding NombreTorneoSeleccionado}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Opacity="0.95"
                           Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- Lista de equipos -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding listaequipo}"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem"
                        Margin="10,0,10,10">
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:EquipoIndexed">
                    <Frame Margin="5,5,5,10"
                           Padding="0"
                           CornerRadius="15"
                           BackgroundColor="White"
                           HasShadow="True"
                           BorderColor="Transparent">
                        
                        <Frame.Shadow>
                            <Shadow Brush="Black" 
                                    Opacity="0.15" 
                                    Radius="10" 
                                    Offset="0,4" />
                        </Frame.Shadow>
                        
                        <Grid RowDefinitions="Auto,1,Auto,1,Auto" 
                              Padding="0">
                            
                            <!-- Franja superior con nombre del equipo y puntos -->
                            <Grid Grid.Row="0" 
                                  BackgroundColor="{StaticResource azulOscuro}"
                                  Padding="15,12"
                                  ColumnDefinitions="Auto,*,Auto">
                                
                                <!-- Posición -->
                                <Frame Grid.Column="0"
                                       WidthRequest="32"
                                       HeightRequest="32"
                                       CornerRadius="16"
                                       Padding="0"
                                       BackgroundColor="White"
                                       HasShadow="False"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0">
                                    <Label Text="{Binding Index}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource verdeOscuro}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>
                                
                                <!-- Nombre del equipo -->
                                <Label Grid.Column="1"
                                       Text="{Binding Equipo.nombre}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="FillAndExpand" />
                                
                                <!-- Puntos destacados -->
                                <Frame Grid.Column="2"
                                       Padding="10,6"
                                       CornerRadius="12"
                                       BackgroundColor="#FFD700"
                                       HasShadow="False"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{Binding Equipo.puntos}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               VerticalOptions="Center" />
                                        <Label Text="pts"
                                               FontSize="11"
                                               TextColor="Black"
                                               Opacity="0.8"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Frame>
                            </Grid>

                            <!-- Línea separadora -->
                            <BoxView Grid.Row="1" 
                                     Color="#E0E0E0" 
                                     HeightRequest="1" />

                            <!-- ✅ DISEÑO FINAL: Foto MUY GRANDE a la izquierda + Estadísticas compactas a la derecha -->
                            <Grid Grid.Row="2" 
                                  Padding="15,20"
                                  BackgroundColor="White"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="15">
                                
                                <!-- ✅ FOTO DEL EQUIPO (Izquierda - MUY GRANDE, ocupa todo el espacio disponible) -->
                                <Grid Grid.Column="0">
                                    
                                    <!-- Si HAY foto: mostrar imagen completa con AspectFit -->
                                    <Frame HeightRequest="220"
                                           CornerRadius="15"
                                           Padding="0"
                                           BackgroundColor="#F8F8F8"
                                           HasShadow="False"
                                           BorderColor="#E0E0E0"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Center"
                                           IsClippedToBounds="True"
                                           IsVisible="{Binding TieneFoto}">
                                        <Image Source="{Binding FotoSource}"
                                               Aspect="AspectFit"
                                               HorizontalOptions="FillAndExpand"
                                               VerticalOptions="FillAndExpand" />
                                    </Frame>
                                    
                                    <!-- Si NO hay foto: mostrar ícono de grupo -->
                                    <Frame HeightRequest="220"
                                           CornerRadius="15"
                                           Padding="20"
                                           BackgroundColor="#F5F5F5"
                                           HasShadow="False"
                                           BorderColor="#DDDDDD"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Center"
                                           IsClippedToBounds="True"
                                           IsVisible="True">
                                        <Frame.Triggers>
                                            <DataTrigger TargetType="Frame" Binding="{Binding TieneFoto}" Value="True">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Frame.Triggers>
                                        <VerticalStackLayout Spacing="12"
                                                             HorizontalOptions="Center"
                                                             VerticalOptions="Center">
                                            <Label Text="👥"
                                                   FontSize="80"
                                                   HorizontalOptions="Center"
                                                   Opacity="0.25" />
                                            <Label Text="Sin foto del equipo"
                                                   FontSize="12"
                                                   TextColor="#999999"
                                                   FontAttributes="Italic"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center"
                                                   Opacity="0.7" />
                                        </VerticalStackLayout>
                                    </Frame>
                                </Grid>
                                
                                <!-- ✅ ESTADÍSTICAS (Derecha - COMPACTAS como puntos) -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="10"
                                                     VerticalOptions="Start"
                                                     HorizontalOptions="End">
                                    
                                    <!-- Goles a Favor (GF) - Compacto -->
                                    <Frame Padding="8,5"
                                           CornerRadius="10"
                                           BackgroundColor="#4CAF50"
                                           HasShadow="False"
                                           BorderColor="Transparent"
                                           WidthRequest="90">
                                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                            <Label Text="GF:"
                                                   FontSize="11"
                                                   TextColor="White"
                                                   Opacity="0.85"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding Equipo.golesfavor}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Frame>
                                    
                                    <!-- Goles en Contra (GC) - Compacto -->
                                    <Frame Padding="8,5"
                                           CornerRadius="10"
                                           BackgroundColor="#F44336"
                                           HasShadow="False"
                                           BorderColor="Transparent"
                                           WidthRequest="90">
                                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                            <Label Text="GC:"
                                                   FontSize="11"
                                                   TextColor="White"
                                                   Opacity="0.85"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding Equipo.golescontra}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Frame>
                                    
                                    <!-- Diferencia de Goles (DIF) - Compacto -->
                                    <Frame Padding="8,5"
                                           CornerRadius="10"
                                           BackgroundColor="#2196F3"
                                           HasShadow="False"
                                           BorderColor="Transparent"
                                           WidthRequest="90">
                                        <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                            <Label Text="DIF:"
                                                   FontSize="11"
                                                   TextColor="White"
                                                   Opacity="0.85"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding Equipo.diferenciagoles}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Frame>

                                    <Button Text="VER MÁS"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            BackgroundColor="{StaticResource verdeOscuro}"
                                            CornerRadius="8"
                                            Padding="12,8"
                                            Margin="0,12,0,0"
                                            WidthRequest="90"
                                            Clicked="OnVerMasEquipoClicked"
                                            CommandParameter="{Binding Equipo}" />
                                    
                                </VerticalStackLayout>
                                
                            </Grid>

                            <!-- Línea separadora -->
                            <BoxView Grid.Row="3" 
                                     Color="#E0E0E0" 
                                     HeightRequest="1" />

                            <!-- Representante -->
                            <Grid Grid.Row="4" 
                                  Padding="15,12"
                                  BackgroundColor="White">
                                <HorizontalStackLayout Spacing="10">
                                    <Frame WidthRequest="36"
                                           HeightRequest="36"
                                           CornerRadius="18"
                                           Padding="0"
                                           HasShadow="False"
                                           BackgroundColor="{StaticResource azulOscuro}"
                                           VerticalOptions="Center">
                                        <Label Text="👤"
                                               FontSize="18"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Frame>
                                    
                                    <VerticalStackLayout VerticalOptions="Center" 
                                                         Spacing="2">
                                        <Label Text="Representante"
                                               FontSize="11"
                                               TextColor="#999999" />
                                        <Label Text="{Binding Equipo.representante}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource azulOscuro}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>
                            
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                    <Label Text="👥"
                           FontSize="60"
                           HorizontalOptions="Center"
                           Opacity="0.3" />
                    <Label Text="No hay equipos registrados"
                           FontSize="16"
                           TextColor="#999999"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0" />
                    <Label Text="Los equipos aparecerán aquí cuando el torneo inicie"
                           FontSize="13"
                           TextColor="#CCCCCC"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="0,5,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            
            <!-- Espacio al final de la lista -->
            <CollectionView.Footer>
                <ContentView HeightRequest="50" />
            </CollectionView.Footer>
            
        </CollectionView>

        <!-- Contador total de equipos -->
        <Frame Grid.Row="2"
               Padding="12"
               CornerRadius="0"
               BackgroundColor="{StaticResource verdeOscuro}"
               HasShadow="False"
               BorderColor="Transparent">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="Equipos participantes:"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Label Text="{Binding TotalEquipos}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Frame>
        
    </Grid>
</ContentPage>