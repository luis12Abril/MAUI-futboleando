<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.EquipoPage"
             Title="Equipos  Page">
    <Grid Padding="10">
        <ListView HasUnevenRows="True" ItemsSource="{Binding listaequipo}" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <VerticalStackLayout Padding="10">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" 
                                    Text="Equipo       :" 
                                    Style="{StaticResource estiloLabel}" 
                                    VerticalOptions="Center" />
                                <Label Grid.Row="0" Grid.Column="1" 
                                    Text="{Binding nombre}" 
                                    Style="{StaticResource estiloLabel}"
                                    Margin="10,0,0,0"
                                    VerticalOptions="Center" />

                                <Label Grid.Row="1" Grid.Column="0" 
                                    Text="Representante :" 
                                    Style="{StaticResource estiloLabel}"
                                    VerticalOptions="Center" />
                                <Label Grid.Row="1" Grid.Column="1" 
                                    Text="{Binding representante}" 
                                    Style="{StaticResource estiloLabel}"
                                    Margin="10,0,0,0"
                                    VerticalOptions="Center" />

                                <Label Grid.Row="2" Grid.Column="0" 
                                    Text="Goles a Favor :" 
                                    Style="{StaticResource estiloLabel}"
                                    VerticalOptions="Center" />
                                <Label Grid.Row="2" Grid.Column="1" 
                                    Text="{Binding golesfavor}" 
                                    Style="{StaticResource estiloLabel}"
                                    Margin="10,0,0,0"
                                    VerticalOptions="Center" />

                                <Label Grid.Row="3" Grid.Column="0" 
                                    Text="Goles en Contra :" 
                                    Style="{StaticResource estiloLabel}"
                                    VerticalOptions="Center" />
                                <Label Grid.Row="3" Grid.Column="1" 
                                    Text="{Binding golescontra}" 
                                    Style="{StaticResource estiloLabel}"
                                    Margin="10,0,0,0"
                                    VerticalOptions="Center" />

                                <Label Grid.Row="4" Grid.Column="0" 
                                    Text="Diferencia de Goles :" 
                                    Style="{StaticResource estiloLabel}"
                                    VerticalOptions="Center" />
                                <Label Grid.Row="4" Grid.Column="1" 
                                    Text="{Binding diferenciagoles}" 
                                    Style="{StaticResource estiloLabel}"
                                    Margin="10,0,0,0"
                                    VerticalOptions="Center" />

                                <Label Grid.Row="5" Grid.Column="0" 
                                    Text="PUNTOS :" 
                                    Style="{StaticResource estiloLabel}"
                                    VerticalOptions="Center" />
                                <Label Grid.Row="5" Grid.Column="1" 
                                    Text="{Binding puntos}" 
                                    Style="{StaticResource estiloLabel}"
                                    Margin="10,0,0,0"
                                    VerticalOptions="Center" />

                            </Grid>
                        </VerticalStackLayout>

                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>