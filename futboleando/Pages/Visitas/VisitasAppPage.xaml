<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.Visitas.VisitasAppPage"
             Title="Visitas"
             BackgroundColor="#F4F6F2"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <Grid Grid.Row="0"
              Padding="1,2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1ECF4E" Offset="0.0" />
                    <GradientStop Color="#12B76A" Offset="0.55" />
                    <GradientStop Color="#F6C945" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="6,4"
                        Margin="0,-8,0,0"
                        Clicked="OnBackClicked" />
                <Frame Grid.Column="1"
                       WidthRequest="46"
                       HeightRequest="46"
                       CornerRadius="23"
                       Padding="0"
                       BackgroundColor="#0F172A"
                       HasShadow="True">
                    <Label Text="📊"
                           FontSize="24"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Frame>
                <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                    <Label Text="VISITAS A USUARIOS"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Web y App"
                           FontSize="12"
                           TextColor="#E6FFEF" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <Frame Grid.Row="1"
               Padding="14"
               CornerRadius="14"
               HasShadow="True"
               BackgroundColor="#0F172A"
               BorderColor="Transparent"
               Margin="15,10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Frame Grid.Column="0"
                       Padding="12"
                       CornerRadius="12"
                       BackgroundColor="#111827"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="TOTAL VISITAS WEB"
                               FontSize="11"
                               TextColor="#C7F9CC" />
                        <Label x:Name="lblTotalWeb"
                               Text="0"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#22C55E"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1"
                       Padding="12"
                       CornerRadius="12"
                       BackgroundColor="#111827"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="TOTAL VISITAS APP"
                               FontSize="11"
                               TextColor="#C7F9CC" />
                        <Label x:Name="lblTotalApp"
                               Text="0"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#22C55E"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>
        </Frame>

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="10" Padding="15,0,15,10">
            <Frame Grid.Column="0"
                   Padding="10,8"
                   CornerRadius="12"
                   BackgroundColor="#FFFFFF"
                   HasShadow="True">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="📋" FontSize="16" />
                    <Label Text="Resumen" FontSize="12" TextColor="#0F172A" />
                </HorizontalStackLayout>
            </Frame>
            <Frame Grid.Column="1"
                   Padding="10,8"
                   CornerRadius="12"
                   BackgroundColor="#ECFDF3"
                   HasShadow="True">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="👥" FontSize="16" />
                    <Label Text="Usuarios" FontSize="12" TextColor="#0F172A" />
                </HorizontalStackLayout>
            </Frame>
            <Frame Grid.Column="2"
                   Padding="10,8"
                   CornerRadius="12"
                   BackgroundColor="#FFFFFF"
                   HasShadow="True">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="📈" FontSize="16" />
                    <Label Text="Actividad" FontSize="12" TextColor="#0F172A" />
                </HorizontalStackLayout>
            </Frame>
        </Grid>

        <Frame Grid.Row="3"
               Padding="12"
               CornerRadius="14"
               BackgroundColor="White"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="15,0,15,10">
            <Border StrokeThickness="1.5"
                    Stroke="#D0D7DE"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#F8F9FA">
                <Grid Padding="10,4" ColumnDefinitions="*,Auto">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="🔍"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="6,0,8,0" />
                        <Picker Grid.Column="1"
                                x:Name="pickerTipoUsuario"
                                Title="-- SELECCIONE UN USUARIO --"
                                ItemsSource="{Binding listatiposusuarios}"
                                ItemDisplayBinding="{Binding nombre}"
                                SelectedItem="{Binding tipoUsuarioSeleccionado}"
                                SelectedIndexChanged="OnTipoUsuarioSelected"
                                FontSize="15"
                                TextColor="#2D3142"
                                TitleColor="#6c757d"
                                BackgroundColor="Transparent" />
                    </Grid>
                    <Button Grid.Column="1"
                            Text="✕"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="{StaticResource rojoOscuro}"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            Clicked="OnLimpiarFiltroClicked"
                            ToolTipProperties.Text="Limpiar filtro" />
                </Grid>
            </Border>
        </Frame>

        <Grid Grid.Row="4" RowDefinitions="Auto,*" BackgroundColor="#F1F8E8">
            <ActivityIndicator x:Name="loadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="#12B76A"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             HeightRequest="50"
                             WidthRequest="50" />

            <Border Grid.Row="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12,12,0,0"
                    BackgroundColor="#0F172A"
                    Margin="12,6,12,0">
                <Grid ColumnDefinitions="1.8*,1.5*,0.8*,0.8*"
                      Padding="16,12"
                      ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="USUARIO"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#C7F9CC"
                           HorizontalOptions="Start" />
                    <Label Grid.Column="1"
                           Text="TIPO USUARIO"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#C7F9CC"
                           HorizontalOptions="Start" />
                    <Label Grid.Column="2"
                           Text="WEB"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#C7F9CC"
                           HorizontalOptions="Center" />
                    <Label Grid.Column="3"
                           Text="APP"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#C7F9CC"
                           HorizontalOptions="Center" />
                </Grid>
            </Border>

            <ListView Grid.Row="1"
                      x:Name="collectionVisitas"
                      ItemsSource="{Binding listavisitas}"
                      SeparatorVisibility="Default"
                      SeparatorColor="#DDE5D6"
                      HasUnevenRows="False"
                      RowHeight="30"
                      VerticalOptions="FillAndExpand"
                      BackgroundColor="#F1F8E8"
                      CachingStrategy="RecycleElement">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid ColumnDefinitions="1.8*,1.5*,0.8*,0.8*"
                                  Padding="10,4"
                                  ColumnSpacing="8"
                                  BackgroundColor="#F8FBEF">
                                <Label Grid.Column="0"
                                       Text="{Binding nombreusuario}"
                                       FontSize="12"
                                       TextColor="#0F172A"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding nombretipousuario}"
                                       FontSize="12"
                                       TextColor="#374151"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding visitasWebFormateado}"
                                       FontSize="12"
                                       TextColor="#111827"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="3"
                                       Text="{Binding visitasAppFormateado}"
                                       FontSize="12"
                                       TextColor="#111827"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Frame Grid.Row="5"
               Padding="12"
               CornerRadius="0"
               BackgroundColor="#0F172A"
               HasShadow="True">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text="🏠" FontSize="18" TextColor="#C7F9CC" HorizontalOptions="Center" />
                    <Label Text="Inicio" FontSize="10" TextColor="#C7F9CC" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text="📊" FontSize="18" TextColor="#C7F9CC" HorizontalOptions="Center" />
                    <Label Text="Visitas" FontSize="10" TextColor="#C7F9CC" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                    <Label Text="⚙️" FontSize="18" TextColor="#C7F9CC" HorizontalOptions="Center" />
                    <Label Text="Ajustes" FontSize="10" TextColor="#C7F9CC" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>
