<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.Visitas.VisitasAppPage"
             Title="Visitas"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        
        <!-- ========== ENCABEZADO ========== -->
        <Frame Grid.Row="0"
               Padding="20,16"
               CornerRadius="0"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="0,0,0,10">
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource azulOscuro}" Offset="0.0" />
                    <GradientStop Color="{StaticResource rojoOscuro}" Offset="1.0" />
                </LinearGradientBrush>
            </Frame.Background>

            <Label Text="📊 VISITAS A WEB Y APP"
                   FontSize="21"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Frame>

        <!-- ========== TOTALES ========== -->
        <Frame Grid.Row="1"
               Padding="18,16"
               CornerRadius="0"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="0,0,0,10">
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1a1a1a" Offset="0.0" />
                    <GradientStop Color="#2d2d2d" Offset="1.0" />
                </LinearGradientBrush>
            </Frame.Background>

            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <!-- Total Visitas Web -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="15">
                    <Label Grid.Column="0"
                           Text="TOTAL VISITAS WEB"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           x:Name="lblTotalWeb"
                           Text="0"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#FFD700"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Total Visitas App -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="15">
                    <Label Grid.Column="0"
                           Text="TOTAL VISITAS APP"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           x:Name="lblTotalApp"
                           Text="0"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#FFD700"
                           VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Frame>

        <!-- ========== FILTRO POR TIPO USUARIO ========== -->
        <Frame Grid.Row="2"
               Padding="12"
               CornerRadius="14"
               BackgroundColor="White"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="15,0,15,10">
            <Border StrokeThickness="1.5"
                    Stroke="#D0D7DE"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#F8F9FA">
                <Grid Padding="10,4" ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0"
                           Text="🔍"
                           FontSize="16"
                           VerticalOptions="Center"
                           Margin="6,0,8,0" />
                    <Picker Grid.Column="1"
                            x:Name="pickerTipoUsuario"
                            Title="-- SELECCIONE TIPO DE USUARIO --"
                            ItemsSource="{Binding listatiposusuarios}"
                            ItemDisplayBinding="{Binding nombre}"
                            SelectedItem="{Binding tipoUsuarioSeleccionado}"
                            SelectedIndexChanged="OnTipoUsuarioSelected"
                            FontSize="15"
                            TextColor="#2D3142"
                            TitleColor="#6c757d"
                            BackgroundColor="Transparent" />
                </Grid>
            </Border>
        </Frame>

        <!-- ========== LISTA DE USUARIOS ========== -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*">
            <!-- Indicador de carga -->
            <ActivityIndicator x:Name="loadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{StaticResource azulOscuro}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             HeightRequest="50"
                             WidthRequest="50" />
            <Border Grid.Row="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12,12,0,0"
                    BackgroundColor="#2D3142"
                    Margin="8,6,8,0">
                <Grid ColumnDefinitions="1.8*,1.5*,0.8*,0.8*"
                      Padding="18,14"
                      ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="USUARIO"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#FFD700"
                           HorizontalOptions="Start" />
                    <Label Grid.Column="1"
                           Text="TIPO USUARIO"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#FFD700"
                           HorizontalOptions="Start" />
                    <Label Grid.Column="2"
                           Text="WEB"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#FFD700"
                           HorizontalOptions="Center" />
                    <Label Grid.Column="3"
                           Text="APP"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#FFD700"
                           HorizontalOptions="Center" />
                </Grid>
            </Border>

            <ListView Grid.Row="1"
                      x:Name="collectionVisitas"
                      ItemsSource="{Binding listavisitas}"
                      SeparatorVisibility="Default"
                      SeparatorColor="#E5E7EB"
                      HasUnevenRows="False"
                      RowHeight="30"
                      VerticalOptions="FillAndExpand"
                      BackgroundColor="#F5F5F5"
                      CachingStrategy="RecycleElement">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid ColumnDefinitions="1.8*,1.5*,0.8*,0.8*"
                                  Padding="10,4"
                                  ColumnSpacing="8"
                                  BackgroundColor="#F1F8E8">
                                <Label Grid.Column="0"
                                       Text="{Binding nombreusuario}"
                                       FontSize="12"
                                       TextColor="#1F2937"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding nombretipousuario}"
                                       FontSize="12"
                                       TextColor="#4B5563"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{Binding visitasWebFormateado}"
                                       FontSize="12"
                                       TextColor="#111827"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="3"
                                       Text="{Binding visitasAppFormateado}"
                                       FontSize="12"
                                       TextColor="#111827"
                                       HorizontalOptions="End"
                                       VerticalOptions="Center" />
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

    </Grid>
</ContentPage>