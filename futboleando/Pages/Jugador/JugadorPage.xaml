<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.JugadorPage"
             Title="Lista de Jugadores">
    <VerticalStackLayout Style="{StaticResource verticalStackLayoutPage}">
        <Label Text="Lista de Jugadores" Style="{StaticResource estiloLabel}" />
        <ListView HasUnevenRows="True" ItemsSource="{Binding listafiltro}" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        
                            <VerticalStackLayout Padding="10">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <Label Grid.Row="0" Grid.Column="0" 
                                           Text="Nombre       :" 
                                           Style="{StaticResource estiloLabel}" 
                                           VerticalOptions="Center" />
                                    <Label Grid.Row="0" Grid.Column="1" 
                                           Text="{Binding nombre}" 
                                           Style="{StaticResource estiloLabel}"
                                           Margin="10,0,0,0"
                                           VerticalOptions="Center" />
                                    
                                    <Label Grid.Row="1" Grid.Column="0" 
                                           Text="Ap. Paterno :" 
                                           Style="{StaticResource estiloLabel}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Row="1" Grid.Column="1" 
                                           Text="{Binding appaterno}" 
                                           Style="{StaticResource estiloLabel}"
                                           Margin="10,0,0,0"
                                           VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                       
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>