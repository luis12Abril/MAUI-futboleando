<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:futboleando.Models"
             x:Class="futboleando.Pages.JugadorPage"
             Title="Jugadores"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">
    
    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0">
        
        <!-- ========== ENCABEZADO ========== -->
        <Grid Grid.Row="0" 
              Padding="1,2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1ECF4E" Offset="0.0" />
                    <GradientStop Color="#12B76A" Offset="0.55" />
                    <GradientStop Color="#F6C945" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="6,4"
                        Margin="0,-8,0,0"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding NombreTorneoSeleccionado}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Opacity="0.95"
                           Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- ========== FILTRO POR EQUIPO ========== -->
        <Frame Grid.Row="1"
               Padding="12"
               CornerRadius="14"
               BackgroundColor="White"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="15,15,15,10">
            <Border StrokeThickness="1.5"
                    Stroke="#D0D7DE"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#F8F9FA">
                <Grid Padding="10,4" ColumnDefinitions="*,Auto">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="🔍"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="6,0,8,0" />
                        <Picker Grid.Column="1"
                                x:Name="pickerEquipo"
                                Title="-- Todos los Equipos --"
                                ItemsSource="{Binding listaequipos}"
                                ItemDisplayBinding="{Binding nombre}"
                                SelectedIndexChanged="OnEquipoSelected"
                                FontSize="14"
                                TextColor="{StaticResource verdeOscuro}"
                                TitleColor="#6c757d"
                                BackgroundColor="Transparent" />
                    </Grid>
                    <Button Grid.Column="1"
                            Text="✕"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="{StaticResource rojoOscuro}"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            Clicked="OnLimpiarFiltroClicked"
                            ToolTipProperties.Text="Limpiar filtro" />
                </Grid>
            </Border>
        </Frame>

        <!-- ========== CONTADOR TOTAL DE JUGADORES ========== -->
        <Frame Grid.Row="2"
               Padding="12,8"
               Margin="15,0,15,10"
               CornerRadius="8"
               BackgroundColor="{StaticResource azulOscuro}"
               HasShadow="False"
               BorderColor="Transparent">
            <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="👥"
                       FontSize="16"
                       TextColor="White"
                       VerticalOptions="Center" />
                <Label Text="{Binding TotalJugadoresTexto}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Frame>

        <!-- ========== LISTA DE JUGADORES (CollectionView optimizado) ========== -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding listajugador}"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem"
                        Margin="10,0,10,10">
            
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:JugadorIndexed">
                    <!-- Contenedor de la tarjeta -->
                    <Frame Margin="5,5,5,10"
                           Padding="0"
                           CornerRadius="15"
                           BackgroundColor="White"
                           HasShadow="True"
                           BorderColor="Transparent">
                        
                        <Frame.Shadow>
                            <Shadow Brush="Black" 
                                    Opacity="0.15" 
                                    Radius="10" 
                                    Offset="0,4" />
                        </Frame.Shadow>
                        
                        <Grid RowDefinitions="Auto,1,Auto,1,Auto" 
                              Padding="0">
                            
                            <!-- Franja superior con número y nombre completo -->
                            <Grid Grid.Row="0" 
                                  BackgroundColor="{StaticResource verdeOscuro}"
                                  Padding="15,12"
                                  ColumnDefinitions="Auto,Auto,*">
                                
                                <!-- Número de jugador -->
                                <Frame Grid.Column="0"
                                       WidthRequest="32"
                                       HeightRequest="32"
                                       CornerRadius="16"
                                       Padding="0"
                                       BackgroundColor="White"
                                       HasShadow="False"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center"
                                       Margin="0,0,10,0">
                                    <Label Text="{Binding Index}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource verdeOscuro}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Frame>
                                
                                <!-- Icono de jugador -->
                                <Label Grid.Column="1"
                                       Text="👤" 
                                       FontSize="20" 
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0" />
                                
                                <!-- Nombre completo -->
                                <Label Grid.Column="2"
                                       Text="{Binding Jugador.nombrecompleto}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="FillAndExpand" />
                            </Grid>

                            <!-- Línea separadora -->
                            <BoxView Grid.Row="1" 
                                     Color="#E0E0E0" 
                                     HeightRequest="1" />

                            <!-- Equipo -->
                            <Grid Grid.Row="2" 
                                  Padding="15,10"
                                  BackgroundColor="White">
                                <HorizontalStackLayout Spacing="10">
                                    <Frame WidthRequest="40"
                                           HeightRequest="40"
                                           CornerRadius="20"
                                           Padding="0"
                                           HasShadow="False"
                                           BackgroundColor="{StaticResource azulOscuro}"
                                           VerticalOptions="Center">
                                        <Label Text="👥"
                                               FontSize="20"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Frame>
                                    
                                    <VerticalStackLayout VerticalOptions="Center" 
                                                         Spacing="2">
                                        <Label Text="Equipo"
                                               FontSize="11"
                                               TextColor="#999999" />
                                        <Label Text="{Binding Jugador.nombreequipo}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource azulOscuro}" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Línea separadora -->
                            <BoxView Grid.Row="3" 
                                     Color="#E0E0E0" 
                                     HeightRequest="1" 
                                     Margin="15,0" />

                            <!-- Fecha de nacimiento y Goles -->
                            <Grid Grid.Row="4" 
                                  Padding="15,10"
                                  BackgroundColor="White"
                                  ColumnDefinitions="*,Auto">
                                
                                <!-- Fecha de Nacimiento -->
                                <HorizontalStackLayout Grid.Column="0" 
                                                       Spacing="8"
                                                       VerticalOptions="Center">
                                    <Label Text="🎂"
                                           FontSize="18"
                                           VerticalOptions="Center" />
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Fecha Nacimiento"
                                               FontSize="10"
                                               TextColor="#999999" />
                                        <Label Text="{Binding Jugador.fnacimiento, StringFormat='{0:dd/MM/yyyy}'}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#424242" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                
                                <!-- Goles -->
                                <Frame Grid.Column="1"
                                       Padding="12,8"
                                       CornerRadius="10"
                                       BackgroundColor="{StaticResource rojoOscuro}"
                                       HasShadow="False"
                                       BorderColor="Transparent"
                                       VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="⚽"
                                               FontSize="18"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Jugador.goles}"
                                               FontSize="20"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               VerticalOptions="Center" />
                                        <Label Text="goles"
                                               FontSize="11"
                                               TextColor="White"
                                               Opacity="0.9"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Frame>
                                
                            </Grid>
                            
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            
            <!-- Espacio al final de la lista -->
            <CollectionView.Footer>
                <ContentView HeightRequest="50" />
            </CollectionView.Footer>
            
        </CollectionView>
        
    </Grid>
</ContentPage>