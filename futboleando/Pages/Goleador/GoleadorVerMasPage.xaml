<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:futboleando.Converters"
             xmlns:entities="clr-namespace:futboleandoEntities.Juego;assembly=futboleandoEntities"
             x:Class="futboleando.Pages.Goleador.GoleadorVerMasPage"
             Title="Goles del Jugador"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EstatusJuegoToColorConverter x:Key="EstatusToColor" />
            <converters:EstatusJuegoToTextColorConverter x:Key="EstatusToTextColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Encabezado -->
        <Grid Grid.Row="0"
              Padding="1,2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource azulOscuro}" Offset="0.0" />
                    <GradientStop Color="{StaticResource verdeOscuro}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="6,4"
                        Margin="0,-8,0,0"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding NombreJugador}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Opacity="0.95"
                           Margin="0,2,0,0" />
                    <Label Text="{Binding TotalGolesTexto}"
                           FontSize="12"
                           TextColor="White"
                           Opacity="0.85" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- Lista de juegos -->
        <Grid Grid.Row="1">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource azulOscuro}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HeightRequest="50"
                               WidthRequest="50" />

            <CollectionView ItemsSource="{Binding listajuegos}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureAllItems"
                            Margin="15,0,15,15">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:JuegoGolesJugadorCLS">
                        <Frame Margin="0,6"
                               Padding="14"
                               CornerRadius="16"
                               HasShadow="True"
                               BackgroundColor="White"
                               BorderColor="#E5E7EB">

                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Frame Grid.Column="0"
                                           Padding="8,4"
                                           CornerRadius="10"
                                           HasShadow="False"
                                           VerticalOptions="Center"
                                           BackgroundColor="{Binding nombreestatusjuego, Converter={StaticResource EstatusToColor}}">
                                        <Label Text="{Binding nombreestatusjuego}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{Binding nombreestatusjuego, Converter={StaticResource EstatusToTextColor}}" />
                                    </Frame>
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="6"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center">
                                        <Label Text="⚽"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding golesjugador}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding golesjugadortexto}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding nombrejornada}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#64748B"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center" />
                                </Grid>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="2*,Auto,2*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="6">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding nombreequipo01}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource azulOscuro}"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2"
                                           HorizontalOptions="FillAndExpand"
                                           HorizontalTextAlignment="End" />

                                    <Frame Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                           Padding="12,8"
                                           CornerRadius="12"
                                           BackgroundColor="#F8FAFC"
                                           HasShadow="False"
                                           BorderColor="#E2E8F0">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding golesequipo01}"
                                                   FontSize="22"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource azulOscuro}"
                                                   VerticalOptions="Center" />
                                            <Label Text="-"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   TextColor="#94A3B8"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding golesequipo02}"
                                                   FontSize="22"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource verdeOscuro}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Frame>

                                    <Label Grid.Row="0" Grid.Column="2"
                                           Text="{Binding nombreequipo02}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource verdeOscuro}"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2"
                                           HorizontalOptions="FillAndExpand"
                                           HorizontalTextAlignment="Start" />
                                </Grid>

                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="10"
                                      RowSpacing="6">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                        <Label Text="📅"
                                               FontSize="14"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding fhorario, StringFormat='{0:dd/MM/yyyy}'}"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="🕐"
                                               FontSize="14"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding fhorario, StringFormat='{0:hh:mm tt}'}"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                        <Label Text="🏟️"
                                               FontSize="14"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding nombrecampo}"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Start">
                                        <Label Text="🧑‍⚖️"
                                               FontSize="14"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding nombrearbitro}"
                                               FontSize="12"
                                               TextColor="#64748B"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center">
                        <Label Text="⚽"
                               FontSize="60"
                               HorizontalOptions="Center"
                               Opacity="0.3" />
                        <Label Text="No hay juegos con goles"
                               FontSize="16"
                               TextColor="#999999"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
                        <Label Text="Este jugador aún no registra goles"
                               FontSize="13"
                               TextColor="#CCCCCC"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <Frame Grid.Row="2"
               Padding="12"
               CornerRadius="0"
               BackgroundColor="{StaticResource verdeOscuro}"
               HasShadow="False"
               BorderColor="Transparent">
            <Label Text="{Binding TotalJuegosTexto}"
                   FontSize="12"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Frame>
    </Grid>
</ContentPage>
