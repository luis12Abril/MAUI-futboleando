<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.Goleador.GoleadorPage"
             Title="Goleadores"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- ========== ENCABEZADO ========== -->
        <Frame Grid.Row="0"
               Padding="20,15"
               CornerRadius="0"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="0,0,0,10">
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource azulOscuro}" Offset="0.0" />
                    <GradientStop Color="{StaticResource rojoOscuro}" Offset="1.0" />
                </LinearGradientBrush>
            </Frame.Background>

            <VerticalStackLayout Spacing="5">
                <Label Text="⚽ GOLEADORES"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                <Label x:Name="lblTorneoNombre"
                       Text="Torneo: Cargando..."
                       FontSize="14"
                       TextColor="White"
                       Opacity="0.9"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Frame>

        <!-- ========== LISTA DE GOLEADORES ========== -->
        <Grid Grid.Row="1">
            <!-- Indicador de carga -->
            <ActivityIndicator x:Name="loadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{StaticResource azulOscuro}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             HeightRequest="50"
                             WidthRequest="50" />
            
            <ScrollView>
                <VerticalStackLayout Padding="8,0,8,5" Spacing="0">
                    
                    <!-- Encabezado de la tabla -->
                    <Border StrokeThickness="3"
                            Stroke="{StaticResource azulOscuro}"
                            StrokeShape="RoundRectangle 15,15,0,0"
                            BackgroundColor="{StaticResource azulOscuro}"
                            Margin="0,10,0,0">
                        <Grid ColumnDefinitions="60,*,80"
                              Padding="15,12"
                              ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="#"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="NOMBRE"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Start" />
                            <Label Grid.Column="2"
                                   Text="GOLES"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Lista de goleadores -->
                    <CollectionView x:Name="collectionGoleadores"
                                    ItemsSource="{Binding listagoleadores}"
                                    SelectionMode="None">
                        
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="-5" />
                        </CollectionView.ItemsLayout>
                        
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="0,0,3,3"
                                        Stroke="{StaticResource azulOscuro}"
                                        BackgroundColor="White"
                                        Margin="0">
                                    
                                    <Grid RowDefinitions="Auto,Auto,Auto,1"
                                          Padding="0">
                                        
                                        <!-- Contenido principal -->
                                        <Grid Grid.Row="0"
                                              RowDefinitions="Auto,Auto"
                                              ColumnDefinitions="Auto,*,Auto"
                                              Padding="20,18"
                                              ColumnSpacing="8"
                                              RowSpacing="8">
                                            
                                            <!-- Posición pequeña en primera línea -->
                                            <Frame Grid.Row="0" Grid.Column="0"
                                                   WidthRequest="24"
                                                   HeightRequest="24"
                                                   CornerRadius="12"
                                                   Padding="0"
                                                   HasShadow="False"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center">
                                                <Frame.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FFD700" Offset="0.0" />
                                                        <GradientStop Color="#FFA500" Offset="1.0" />
                                                    </LinearGradientBrush>
                                                </Frame.Background>
                                                <Frame.Triggers>
                                                    <DataTrigger TargetType="Frame" Binding="{Binding posicion}" Value="2">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#C0C0C0" Offset="0.0" />
                                                                    <GradientStop Color="#A8A8A8" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Frame" Binding="{Binding posicion}" Value="3">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#CD7F32" Offset="0.0" />
                                                                    <GradientStop Color="#B87333" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Frame.Triggers>
                                                <Label Text="{Binding posicion}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Frame>
                                            
                                            <!-- Nombre del jugador en primera línea -->
                                            <Label Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{Binding nombrecompleto}"
                                                   FontSize="17"
                                                   FontAttributes="Bold"
                                                   TextColor="#333333"
                                                   LineBreakMode="WordWrap"
                                                   MaxLines="2"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,0,0" />
                                            
                                            <!-- Nombre del equipo alineado a la izquierda -->
                                            <Label Grid.Row="1" Grid.Column="1"
                                                   Text="{Binding nombreequipo}"
                                                   FontSize="13"
                                                   TextColor="#666666"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="Start"
                                                   Margin="0,0,0,0" />
                                            
                                            <!-- Goles al final de la segunda línea -->
                                            <Frame Grid.Row="1" Grid.Column="2"
                                                   WidthRequest="55"
                                                   HeightRequest="55"
                                                   CornerRadius="27.5"
                                                   Padding="0"
                                                   HasShadow="False"
                                                   BackgroundColor="{StaticResource verdeOscuro}"
                                                   HorizontalOptions="End"
                                                   VerticalOptions="Center">
                                                <Label Text="{Binding goles}"
                                                       FontSize="24"
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Frame>
                                        </Grid>

                                        <!-- Botón Ver Más -->
                                        <Grid Grid.Row="1"
                                              Padding="15,0,15,15">
                                            <Button Text="VER MÁS"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    TextColor="White"
                                                    BackgroundColor="{StaticResource azulOscuro}"
                                                    CornerRadius="8"
                                                    Padding="20,10"
                                                    Clicked="OnVerMasClicked"
                                                    CommandParameter="{Binding idjugador}"
                                                    HorizontalOptions="End">
                                                <Button.Shadow>
                                                    <Shadow Brush="{StaticResource azulOscuro}" 
                                                            Opacity="0.3" 
                                                            Radius="5" 
                                                            Offset="0,2" />
                                                </Button.Shadow>
                                            </Button>
                                        </Grid>

                                        <!-- Separador sutil -->
                                        <BoxView Grid.Row="3"
                                                 Color="#E0E0E0"
                                                 HeightRequest="1"
                                                 Margin="15,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="40"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center">
                                <Label Text="⚽"
                                       FontSize="60"
                                       HorizontalOptions="Center"
                                       Opacity="0.3" />
                                <Label Text="No hay goleadores registrados"
                                       FontSize="16"
                                       TextColor="#999999"
                                       HorizontalOptions="Center"
                                       Margin="0,10,0,0" />
                                <Label Text="Los jugadores con goles aparecerán aquí"
                                       FontSize="13"
                                       TextColor="#CCCCCC"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,5,0,0" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ========== PIE DE PÁGINA ========== -->
        <Frame Grid.Row="2"
               Padding="12"
               CornerRadius="0"
               BackgroundColor="#E8E8E8"
               HasShadow="False"
               BorderColor="Transparent">
            <Label x:Name="lblTotalGoleadores"
                   Text="Total de goleadores: 0"
                   FontSize="12"
                   TextColor="#666666"
                   HorizontalOptions="Center" />
        </Frame>

    </Grid>
</ContentPage>