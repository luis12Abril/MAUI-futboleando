<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.Goleador.GoleadorPage"
             Title="Goleadores"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- ========== ENCABEZADO ========== -->
        <Frame Grid.Row="0"
               Padding="12,10"
               CornerRadius="0"
               HasShadow="False"
               BorderColor="Transparent"
               BackgroundColor="{StaticResource azulOscuro}"
               Margin="0,0,0,8">
            <Label x:Name="lblTorneoNombre"
                   Text="Torneo: Cargando..."
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />
        </Frame>

        <!-- ========== FILTRO POR EQUIPO ========== -->
        <Frame Grid.Row="1"
               Padding="10"
               CornerRadius="10"
               BackgroundColor="White"
               HasShadow="False"
               BorderColor="Transparent"
               Margin="12,0,12,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0"
                        StrokeThickness="1"
                        Stroke="{StaticResource verdeOscuro}"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#F8F9FA">
                    <Picker x:Name="pickerEquipo"
                            Title="-- Todos los Equipos --"
                            ItemsSource="{Binding listaequipos}"
                            ItemDisplayBinding="{Binding nombre}"
                            SelectedIndexChanged="OnEquipoSelected"
                            FontSize="14"
                            TextColor="{StaticResource verdeOscuro}"
                            TitleColor="#6c757d"
                            BackgroundColor="Transparent"
                            Margin="8,3" />
                </Border>
                <Button Grid.Column="1"
                        Text="✕"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="{StaticResource rojoOscuro}"
                        CornerRadius="8"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        Clicked="OnLimpiarFiltroClicked"
                        ToolTipProperties.Text="Limpiar filtro" />
            </Grid>
        </Frame>

        <!-- ========== LISTA DE GOLEADORES ========== -->
        <Grid Grid.Row="2">
            <!-- Indicador de carga -->
            <ActivityIndicator x:Name="loadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{StaticResource azulOscuro}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             HeightRequest="50"
                             WidthRequest="50" />
            
            <ScrollView>
                <VerticalStackLayout Padding="8,0,8,5" Spacing="0">
                    
                    <!-- Encabezado de la tabla -->
                    <Border StrokeThickness="2"
                            Stroke="{StaticResource azulOscuro}"
                            StrokeShape="RoundRectangle 10,10,0,0"
                            BackgroundColor="{StaticResource azulOscuro}"
                            Margin="0,5,0,0">
                        <Grid ColumnDefinitions="45,*,60"
                              Padding="10,8"
                              ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="#"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="NOMBRE"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Start" />
                            <Label Grid.Column="2"
                                   Text="GOLES"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Lista de goleadores -->
                    <CollectionView x:Name="collectionGoleadores"
                                    ItemsSource="{Binding listagoleadores}"
                                    SelectionMode="None">
                        
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
                        </CollectionView.ItemsLayout>
                        
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid RowDefinitions="Auto,Auto"
                                      BackgroundColor="White"
                                      Padding="0"
                                      Margin="0,0,0,1">
                                        
                                        <!-- Contenido principal más compacto -->
                                        <Grid Grid.Row="0"
                                              ColumnDefinitions="28,*,60"
                                              Padding="10,12,10,12"
                                              ColumnSpacing="8">
                                            
                                            <!-- Posición como badge simple -->
                                            <Border Grid.Column="0"
                                                    WidthRequest="22"
                                                    HeightRequest="22"
                                                    StrokeThickness="0"
                                                    BackgroundColor="#FFD700"
                                                    StrokeShape="RoundRectangle 11"
                                                    HorizontalOptions="Start"
                                                    VerticalOptions="Center">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding posicion}" Value="2">
                                                        <Setter Property="BackgroundColor" Value="#C0C0C0" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding posicion}" Value="3">
                                                        <Setter Property="BackgroundColor" Value="#CD7F32" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding posicion}" Value="1">
                                                        <Setter Property="BackgroundColor" Value="#FFD700" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding posicion}"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            
                                            <!-- Información del jugador en vertical compacto -->
                                            <VerticalStackLayout Grid.Column="1" 
                                                                 Spacing="2"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding nombrecompleto}"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="#333333"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                                <Label Text="{Binding nombreequipo}"
                                                       FontSize="11"
                                                       TextColor="#666666"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1" />
                                            </VerticalStackLayout>
                                            
                                            <!-- Goles compacto y perfectamente circular -->
                                            <Border Grid.Column="2"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{StaticResource verdeOscuro}"
                                                    StrokeShape="Ellipse"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Margin="0">
                                                <Label Text="{Binding goles}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="White"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Margin="0" />
                                            </Border>
                                        </Grid>

                                        <!-- Botón Ver Más compacto -->
                                        <Grid Grid.Row="1"
                                              Padding="10,0,10,6">
                                            <Button Text="VER MÁS"
                                                    FontSize="10"
                                                    FontAttributes="Bold"
                                                    TextColor="White"
                                                    BackgroundColor="{StaticResource azulOscuro}"
                                                    CornerRadius="6"
                                                    Padding="8,2"
                                                    Clicked="OnVerMasClicked"
                                                    CommandParameter="{Binding idjugador}"
                                                    HorizontalOptions="End" />
                                        </Grid>
                                    </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="40"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center">
                                <Label Text="⚽"
                                       FontSize="60"
                                       HorizontalOptions="Center"
                                       Opacity="0.3" />
                                <Label Text="No hay goleadores registrados"
                                       FontSize="16"
                                       TextColor="#999999"
                                       HorizontalOptions="Center"
                                       Margin="0,10,0,0" />
                                <Label Text="Los jugadores con goles aparecerán aquí"
                                       FontSize="13"
                                       TextColor="#CCCCCC"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,5,0,0" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ========== PIE DE PÁGINA ========== -->
        <Frame Grid.Row="3"
               Padding="8"
               CornerRadius="0"
               BackgroundColor="#E8E8E8"
               HasShadow="False"
               BorderColor="Transparent">
            <Label x:Name="lblTotalGoleadores"
                   Text="Total de goleadores: 0"
                   FontSize="11"
                   TextColor="#666666"
                   HorizontalOptions="Center" />
        </Frame>

    </Grid>
</ContentPage>