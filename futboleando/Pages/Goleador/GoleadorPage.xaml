<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:entities="clr-namespace:futboleandoEntities.Goleador;assembly=futboleandoEntities"
             x:Class="futboleando.Pages.Goleador.GoleadorPage"
             Title="Goleadores"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- ========== ENCABEZADO ========== -->
        <Grid Grid.Row="0"
              Padding="1,2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource azulOscuro}" Offset="0.0" />
                    <GradientStop Color="{StaticResource verdeOscuro}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="6,4"
                        Margin="0,-8,0,0"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label x:Name="lblTorneoNombre"
                           Text="Cargando..."
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Opacity="0.95"
                           Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- ========== FILTRO POR EQUIPO ========== -->
        <Frame Grid.Row="1"
               Padding="12"
               CornerRadius="14"
               BackgroundColor="White"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="15,15,15,10">
            <Border StrokeThickness="1.5"
                    Stroke="#D0D7DE"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#F8F9FA">
                <Grid Padding="10,4" ColumnDefinitions="*,Auto">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="🔍"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="6,0,8,0" />
                        <Picker Grid.Column="1"
                                x:Name="pickerEquipo"
                                Title="-- Todos los Equipos --"
                                ItemsSource="{Binding listaequipos}"
                                ItemDisplayBinding="{Binding nombre}"
                                SelectedIndexChanged="OnEquipoSelected"
                                FontSize="14"
                                TextColor="{StaticResource verdeOscuro}"
                                TitleColor="#6c757d"
                                BackgroundColor="Transparent" />
                    </Grid>
                    <Button Grid.Column="1"
                            Text="✕"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="{StaticResource rojoOscuro}"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            Clicked="OnLimpiarFiltroClicked"
                            ToolTipProperties.Text="Limpiar filtro" />
                </Grid>
            </Border>
        </Frame>

        <!-- ========== LISTA DE GOLEADORES ========== -->
        <Grid Grid.Row="2">
            <!-- Indicador de carga -->
            <ActivityIndicator x:Name="loadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{StaticResource azulOscuro}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             HeightRequest="50"
                             WidthRequest="50" />

            <CollectionView x:Name="collectionGoleadores"
                            ItemsSource="{Binding listagoleadores}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem"
                            Margin="10,0,10,10">

                <CollectionView.Header>
                    <Border StrokeThickness="2"
                            Stroke="{StaticResource azulOscuro}"
                            StrokeShape="RoundRectangle 10,10,0,0"
                            BackgroundColor="{StaticResource azulOscuro}"
                            Margin="0,5,0,0">
                        <Grid ColumnDefinitions="45,*,60"
                              Padding="10,8"
                              ColumnSpacing="8">
                            <Label Grid.Column="0"
                                   Text="#"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="NOMBRE"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Start" />
                            <Label Grid.Column="2"
                                   Text="GOLES"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                        </Grid>
                    </Border>
                </CollectionView.Header>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:GoleadorCLS">
                        <Frame Margin="0,0,0,6"
                               Padding="0"
                               CornerRadius="12"
                               BackgroundColor="White"
                               HasShadow="True"
                               BorderColor="Transparent">

                            <Grid RowDefinitions="Auto,Auto"
                                  Padding="0">

                                <Grid Grid.Row="0"
                                      ColumnDefinitions="28,*,60"
                                      Padding="12,12,12,10"
                                      ColumnSpacing="10">

                                    <Border Grid.Column="0"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            StrokeThickness="0"
                                            BackgroundColor="#FFD700"
                                            StrokeShape="RoundRectangle 11"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding posicion}" Value="2">
                                                <Setter Property="BackgroundColor" Value="#C0C0C0" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding posicion}" Value="3">
                                                <Setter Property="BackgroundColor" Value="#CD7F32" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding posicion}" Value="1">
                                                <Setter Property="BackgroundColor" Value="#FFD700" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding posicion}"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="2"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding nombrecompleto}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#1E293B"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Text="{Binding nombreequipo}"
                                               FontSize="11"
                                               TextColor="#64748B"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </VerticalStackLayout>

                                    <Border Grid.Column="2"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource verdeOscuro}"
                                            StrokeShape="Ellipse"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding goles}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1"
                                      Padding="12,0,12,10">
                                    <Button Text="VER MÁS"
                                            FontSize="10"
                                            FontAttributes="Bold"
                                            TextColor="White"
                                            BackgroundColor="{StaticResource azulOscuro}"
                                            CornerRadius="6"
                                            Padding="8,2"
                                            Clicked="OnVerMasClicked"
                                            CommandParameter="{Binding idjugador}"
                                            HorizontalOptions="End" />
                                </Grid>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center">
                        <Label Text="⚽"
                               FontSize="60"
                               HorizontalOptions="Center"
                               Opacity="0.3" />
                        <Label Text="No hay goleadores registrados"
                               FontSize="16"
                               TextColor="#999999"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
                        <Label Text="Los jugadores con goles aparecerán aquí"
                               FontSize="13"
                               TextColor="#CCCCCC"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- ========== PIE DE PÁGINA ========== -->
        <Frame Grid.Row="3"
               Padding="10"
               CornerRadius="0"
               BackgroundColor="{StaticResource verdeOscuro}"
               HasShadow="False"
               BorderColor="Transparent">
            <Label x:Name="lblTotalGoleadores"
                   Text="Total de goleadores: 0"
                   FontSize="12"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Frame>

    </Grid>
</ContentPage>