<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.Cumpleañero.CumpleañeroPage"
             Title="Próximos Cumpleañeros"
             BackgroundColor="#F4F6F2"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        
        <!-- ========== ENCABEZADO ========== -->
        <Frame Grid.Row="0"
               Padding="18,16"
               CornerRadius="0"
               HasShadow="True"
               BorderColor="Transparent">
            <Frame.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1ECF4E" Offset="0.0" />
                    <GradientStop Color="#12B76A" Offset="0.5" />
                    <GradientStop Color="#0A8F3F" Offset="1.0" />
                </LinearGradientBrush>
            </Frame.Background>
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="4"
                        Clicked="OnBackClicked" />
                <Image Grid.Column="1"
                       Source="logo_futboleandomenu.png"
                       HeightRequest="42"
                       WidthRequest="42"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Aspect="AspectFit" />
                <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                    <Label Text="PRÓXIMOS CUMPLEAÑEROS"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Celebramos contigo"
                           FontSize="12"
                           TextColor="#E6FFEF" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- ========== FILTRO POR EQUIPO ========== -->
        <Frame Grid.Row="1"
               Padding="12"
               CornerRadius="14"
               BackgroundColor="#0F172A"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="15,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0"
                        StrokeThickness="1.5"
                        Stroke="#1ECF4E"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#111827">
                    <Picker x:Name="pickerEquipo"
                            Title="-- SELECCIONE UN EQUIPO --"
                            ItemsSource="{Binding listaequipos}"
                            ItemDisplayBinding="{Binding nombre}"
                            SelectedIndexChanged="OnEquipoSelected"
                            FontSize="14"
                            TextColor="#C7F9CC"
                            TitleColor="#9CA3AF"
                            BackgroundColor="Transparent"
                            Margin="10,4" />
                </Border>
                <Button Grid.Column="1"
                        Text="✕"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="#0A8F3F"
                        CornerRadius="10"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        Clicked="OnLimpiarFiltroClicked"
                        ToolTipProperties.Text="Mostrar todos" />
            </Grid>
        </Frame>

        <!-- ========== ENCABEZADO DE TABLA ========== -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12,12,0,0"
                BackgroundColor="#0F172A"
                Margin="12,0,12,5">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  Padding="15,10"
                  ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="NOMBRE"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#C7F9CC"
                       HorizontalOptions="Start"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="F. NAC."
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#C7F9CC"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="CUMPL"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#C7F9CC"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,0,10,0" />
            </Grid>
        </Border>

        <!-- ========== LISTA DE CUMPLEAÑEROS ========== -->
        <Grid Grid.Row="3" BackgroundColor="#F1F8E8">
            <CollectionView x:Name="collectionCumpleañeros"
                            ItemsSource="{Binding listacumpleañeros}"
                            SelectionMode="None"
                            Margin="12,0,12,5">
                
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                        
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#F8FBEF"
                                        Padding="15,12">
                                    
                                    <Grid RowDefinitions="Auto,Auto,Auto"
                                          ColumnDefinitions="*,Auto,Auto"
                                          RowSpacing="6"
                                          ColumnSpacing="10">
                                        
                                        <!-- NOMBRE (primera fila, ocupa toda la columna izquierda) -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding nombrecompleto}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               LineBreakMode="WordWrap"
                                               MaxLines="2"
                                               VerticalOptions="Center" />
                                        
                                        <!-- FECHA (primera fila, columna central) -->
                                        <Label Grid.Row="0" Grid.Column="1"
                                               Text="{Binding fechaDisplay}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding esCumpleañosHoy}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource rojoOscuro}" />
                                                    <Setter Property="FontSize" Value="18" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        
                                        <!-- EDAD (primera fila, columna derecha) -->
                                        <Label Grid.Row="0" Grid.Column="2"
                                               Text="{Binding edad}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               Margin="0,0,10,0" />
                                        
                                        <!-- EQUIPO (segunda fila, ocupa todas las columnas) -->
                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                               Text="{Binding nombreequipo}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="#374151"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="40"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center"
                                               Spacing="10">
                                <Label Text="🎂"
                                       FontSize="60"
                                       HorizontalOptions="Center"
                                       Opacity="0.3" />
                                <Label Text="No hay cumpleañeros próximos"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#6B7280"
                                       HorizontalOptions="Center"
                                       Margin="0,10,0,0" />
                                <Label Text="Los jugadores que cumplan años en las próximas 2 semanas aparecerán aquí"
                                       FontSize="13"
                                       TextColor="#9CA3AF"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,5,0,0" />
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
            
            
            <!-- Indicador de carga (encima de todo) -->
            <ActivityIndicator x:Name="loadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{StaticResource azulOscuro}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             HeightRequest="50"
                             WidthRequest="50" />
        </Grid>

        <!-- ========== PIE DE PÁGINA ========== -->
        <Frame Grid.Row="4"
               Padding="12"
               CornerRadius="0"
               BackgroundColor="#0F172A"
               HasShadow="True"
               BorderColor="Transparent">
            <Label x:Name="lblTotalCumpleañeros"
                   Text="Total de cumpleañeros: 0"
                   FontSize="11"
                   TextColor="#C7F9CC"
                   HorizontalOptions="Center" />
        </Frame>

    </Grid>
</ContentPage>