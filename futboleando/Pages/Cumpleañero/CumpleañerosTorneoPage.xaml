<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.Cumpleañero.CumpleañerosTorneoPage"
             Title="Cumpleañeros"
             BackgroundColor="#F4F6F2"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <Grid Grid.Row="0"
              Padding="1,2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="{StaticResource azulOscuro}" Offset="0.0" />
                    <GradientStop Color="{StaticResource verdeOscuro}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="6,4"
                        Margin="0,-8,0,0"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label x:Name="lblTorneoNombre"
                           Text="Torneo: Sin torneo"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Opacity="0.95"
                           Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <Frame Grid.Row="1"
               Padding="12"
               CornerRadius="14"
               BackgroundColor="White"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="15,10">
            <Border StrokeThickness="1.5"
                    Stroke="#D0D7DE"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#F8F9FA">
                <Grid Padding="10,4" ColumnDefinitions="*,Auto">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="🔍"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="6,0,8,0" />
                        <Picker Grid.Column="1"
                                x:Name="pickerEquipo"
                                Title="-- SELECCIONE UN EQUIPO --"
                                ItemsSource="{Binding listaequipos}"
                                ItemDisplayBinding="{Binding nombre}"
                                SelectedIndexChanged="OnEquipoSelected"
                                FontSize="14"
                                TextColor="{StaticResource verdeOscuro}"
                                TitleColor="#6c757d"
                                BackgroundColor="Transparent" />
                    </Grid>
                    <Button Grid.Column="1"
                            Text="✕"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="{StaticResource rojoOscuro}"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            Clicked="OnLimpiarFiltroClicked"
                            ToolTipProperties.Text="Mostrar todos" />
                </Grid>
            </Border>
        </Frame>

        <Border Grid.Row="2"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12,12,0,0"
                BackgroundColor="{StaticResource azulOscuro}"
                Margin="12,0,12,5">
            <Grid ColumnDefinitions="*,75,50"
                  Padding="15,10"
                  ColumnSpacing="10">
                <Label Grid.Column="0"
                       Text="NOMBRE"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Start"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="NACIMIENTO"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="End"
                       HorizontalTextAlignment="End"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="CUMPLE"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" BackgroundColor="#F5F5F5">
            <CollectionView x:Name="collectionCumpleañeros"
                            ItemsSource="{Binding listacumpleañeros}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem"
                            Margin="12,0,12,5">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="15,12"
                               CornerRadius="12"
                               BackgroundColor="White"
                               HasShadow="True"
                               BorderColor="Transparent">

                            <Grid RowDefinitions="Auto,Auto"
                                  ColumnDefinitions="*,70,50"
                                  RowSpacing="4"
                                  ColumnSpacing="10">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding nombrecompleto}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1"
                                       VerticalOptions="Center" />

                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding fechaDisplay}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       HorizontalOptions="End"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center" />

                                <Label Grid.Row="0" Grid.Column="2"
                                       Text="{Binding edad}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center" />

                                <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                       Text="{Binding nombreequipo}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#374151"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="10">
                        <Label Text="🎂"
                               FontSize="60"
                               HorizontalOptions="Center"
                               Opacity="0.3" />
                        <Label Text="No hay cumpleañeros próximos"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#6B7280"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
                        <Label Text="Los jugadores que cumplan años en las próximas 2 semanas aparecerán aquí"
                               FontSize="13"
                               TextColor="#9CA3AF"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <ActivityIndicator x:Name="loadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{StaticResource azulOscuro}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HeightRequest="50"
                               WidthRequest="50" />
        </Grid>

        <Frame Grid.Row="4"
               Padding="12"
               CornerRadius="0"
               BackgroundColor="{StaticResource verdeOscuro}"
               HasShadow="False"
               BorderColor="Transparent">
            <Label x:Name="lblTotalCumpleañeros"
                   Text="Total de cumpleañeros: 0"
                   FontSize="12"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Frame>

    </Grid>
</ContentPage>
