<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="futboleando.Pages.Comunicado.ComunicadoPage"
             Title="Comunicados"
             BackgroundColor="#F4F6F2"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*" Padding="0">

        <Grid Grid.Row="0"
              Padding="1,2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1ECF4E" Offset="0.0" />
                    <GradientStop Color="#12B76A" Offset="0.55" />
                    <GradientStop Color="#F6C945" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>
            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="&#x2190;"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="6,4"
                        Margin="0,-8,0,0"
                        Clicked="OnBackClicked" />
                <Frame Grid.Column="1"
                       WidthRequest="46"
                       HeightRequest="46"
                       CornerRadius="23"
                       Padding="0"
                       BackgroundColor="#0F172A"
                       HasShadow="True">
                    <Label Text="📢"
                           FontSize="22"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Frame>
                <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                    <Label Text="COMUNICADOS OFICIALES"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Informacion importante del torneo"
                           FontSize="12"
                           TextColor="#E6FFEF" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" BackgroundColor="#F1F8E8">
            <ListView x:Name="listViewComunicados"
                      ItemsSource="{Binding listacomunicado}"
                      HasUnevenRows="True"
                      SeparatorVisibility="None"
                      BackgroundColor="Transparent"
                      Margin="12,10,12,10">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Frame Margin="0,0,0,15"
                                   Padding="0"
                                   CornerRadius="12"
                                   BackgroundColor="White"
                                   HasShadow="True"
                                   BorderColor="Transparent">

                                <Frame.Shadow>
                                    <Shadow Brush="Black"
                                            Opacity="0.15"
                                            Radius="10"
                                            Offset="0,4" />
                                </Frame.Shadow>

                                <Grid RowDefinitions="Auto,Auto,1,Auto"
                                      Padding="0">

                                    <Grid Grid.Row="0"
                                          BackgroundColor="#0F172A"
                                          Padding="15,10">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="FECHA" FontSize="12" VerticalOptions="Center" />
                                            <Label Text="{Binding fechacomunicadoformateada}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="#C7F9CC"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Grid Grid.Row="1"
                                          Padding="15,12,15,8"
                                          BackgroundColor="White">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="📢"
                                                   FontSize="14"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding comunicadocorto}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#0F172A"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="FillAndExpand" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <BoxView Grid.Row="2"
                                             Color="#E0E0E0"
                                             HeightRequest="1"
                                             Margin="15,0" />

                                    <Grid Grid.Row="3"
                                          Padding="15,12,15,15"
                                          BackgroundColor="White">
                                        <Label Text="{Binding comunicadolargo}"
                                               FontSize="14"
                                               TextColor="#424242"
                                               LineBreakMode="WordWrap"
                                               LineHeight="1.4"
                                               VerticalOptions="Start" />
                                    </Grid>
                                </Grid>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.Footer>
                    <ContentView HeightRequest="50" />
                </ListView.Footer>
            </ListView>

            <Frame x:Name="frameNoComunicados"
                   IsVisible="False"
                   Padding="30"
                   Margin="20"
                   CornerRadius="20"
                   BackgroundColor="White"
                   HasShadow="True"
                   BorderColor="Transparent"
                   VerticalOptions="Center">

                <Frame.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,5" />
                </Frame.Shadow>

                <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Frame WidthRequest="100"
                           HeightRequest="100"
                           CornerRadius="50"
                           Padding="0"
                           BackgroundColor="#F0F4F8"
                           HasShadow="False"
                           HorizontalOptions="Center"
                           BorderColor="Transparent">
                        <Label Text="📢"
                               FontSize="32"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Frame>

                    <Label Text="Sin comunicados por el momento"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#0F172A"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Label FontSize="15"
                           TextColor="#666666"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineHeight="1.5">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Este torneo aun no cuenta con comunicados oficiales."/>
                                <Span Text="&#10;"/>
                                <Span Text="Aqui se publicaran noticias, avisos y actualizaciones importantes."/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <BoxView Color="#0F172A"
                             HeightRequest="3"
                             WidthRequest="60"
                             CornerRadius="2"
                             HorizontalOptions="Center"
                             Margin="0,10,0,0" />

                    <Label Text="Mantente atento a futuras actualizaciones"
                           FontSize="13"
                           FontAttributes="Italic"
                           TextColor="#999999"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>
