<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:futboleando.Models"
             x:Class="futboleando.Pages.Juego.UltimosCincoJuegosPage"
             Title="Ultimos cinco juegos"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ========== ENCABEZADO ========== -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource verdeOscuro}"
              Padding="12,14">
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="4"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label x:Name="lblTorneoNombre"
                           Text="Torneo: Sin torneo"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Opacity="0.95"
                           Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12,12,0,0"
                BackgroundColor="{StaticResource azulOscuro}"
                Margin="15,12,15,5">
            <Grid ColumnDefinitions="*,40,32,32,32,32,32"
                  Padding="12,10"
                  ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="EQUIPOS"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       LineBreakMode="NoWrap"
                       HorizontalOptions="Start"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="PTOS"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="Center" />
                <Label Grid.Column="2"
                       Text="ULT."
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="Center" />
                <Label Grid.Column="3"
                       Text="J2"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="Center" />
                <Label Grid.Column="4"
                       Text="J3"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="Center" />
                <Label Grid.Column="5"
                       Text="J4"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="Center" />
                <Label Grid.Column="6"
                       Text="J5"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="FillAndExpand"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- ========== LISTA DE ÚLTIMOS CINCO ========== -->
        <Grid Grid.Row="2">
            <CollectionView x:Name="collectionUltimosCinco"
                            ItemsSource="{Binding ListaUltimosCinco}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureFirstItem"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReached="OnRemainingItemsThresholdReached"
                            Margin="15,0,15,5">

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:UltimosCincoJuegosEquipoModel">
                        <Grid BackgroundColor="White"
                              Padding="10,8"
                              ColumnDefinitions="*,40,32,32,32,32,32"
                              ColumnSpacing="8"
                              HeightRequest="36">
                            <Label Grid.Column="0"
                                   Text="{Binding EquipoNombre}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="Black"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Puntos}"
                                   FontSize="12"
                                   TextColor="Black"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2"
                                   Text="{Binding Ultimo}"
                                   FontSize="12"
                                   TextColor="Black"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="3"
                                   Text="{Binding Juego2}"
                                   FontSize="12"
                                   TextColor="Black"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="4"
                                   Text="{Binding Juego3}"
                                   FontSize="12"
                                   TextColor="Black"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="5"
                                   Text="{Binding Juego4}"
                                   FontSize="12"
                                   TextColor="Black"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="6"
                                   Text="{Binding Juego5}"
                                   FontSize="12"
                                   TextColor="Black"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="10">
                        <Label Text="⚽"
                               FontSize="60"
                               HorizontalOptions="Center"
                               Opacity="0.3" />
                        <Label Text="No hay juegos jugados"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#6B7280"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
                        <Label Text="Los resultados se mostrarán cuando existan juegos jugados"
                               FontSize="13"
                               TextColor="#9CA3AF"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>

            <ActivityIndicator x:Name="loadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{StaticResource azulOscuro}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               HeightRequest="50"
                               WidthRequest="50" />
        </Grid>

        <!-- ========== PIE DE PÁGINA ========== -->
        <Frame Grid.Row="3"
               Padding="12"
               CornerRadius="0"
               BackgroundColor="{StaticResource verdeOscuro}"
               HasShadow="True"
               BorderColor="Transparent">
            <Label x:Name="lblTotalEquipos"
                   Text="Total equipos: 0"
                   FontSize="12"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Frame>

    </Grid>
</ContentPage>
