<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:futboleando.Converters"
             xmlns:entities="clr-namespace:futboleandoEntities.Juego;assembly=futboleandoEntities"
             x:Class="futboleando.Pages.Juego.JuegoPage"
             Title="Juegos del Torneo"
             BackgroundColor="#F5F5F5"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:EstatusJuegoToColorConverter x:Key="EstatusToColor" />
            <converters:EstatusJuegoToTextColorConverter x:Key="EstatusToTextColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!-- ========== ENCABEZADO ========== -->
        <Grid Grid.Row="0"
              Padding="1,2">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1ECF4E" Offset="0.0" />
                    <GradientStop Color="#12B76A" Offset="0.55" />
                    <GradientStop Color="#F6C945" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Grid.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="←"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        Padding="6,4"
                        Margin="0,-8,0,0"
                        Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding NombreTorneoSeleccionado}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Opacity="0.95"
                           Margin="0,2,0,0" />
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- ========== FILTRO POR JORNADA ========== -->
        <Frame Grid.Row="1"
               Padding="12"
               CornerRadius="14"
               BackgroundColor="White"
               HasShadow="True"
               BorderColor="Transparent"
               Margin="15,15,15,10">
            <Border StrokeThickness="1.5"
                    Stroke="#D0D7DE"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="#F8F9FA">
                <Grid Padding="10,4" ColumnDefinitions="*,Auto">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0"
                               Text="🔍"
                               FontSize="16"
                               VerticalOptions="Center"
                               Margin="6,0,8,0" />
                        <Picker Grid.Column="1"
                                x:Name="pickerJornada"
                                Title="-- Todas las Jornadas --"
                                ItemsSource="{Binding listajornada}"
                                ItemDisplayBinding="{Binding nombre}"
                                SelectedItem="{Binding jornadaSeleccionada}"
                                SelectedIndexChanged="OnJornadaSelected"
                                FontSize="14"
                                TextColor="{StaticResource verdeOscuro}"
                                TitleColor="#6c757d"
                                BackgroundColor="Transparent" />
                    </Grid>
                    <Button Grid.Column="1"
                            Text="✕"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White"
                            BackgroundColor="{StaticResource rojoOscuro}"
                            CornerRadius="8"
                            WidthRequest="40"
                            HeightRequest="40"
                            Padding="0"
                            Clicked="OnLimpiarFiltroClicked"
                            ToolTipProperties.Text="Limpiar filtro" />
                </Grid>
            </Border>
        </Frame>

        <!-- ========== LISTA DE JUEGOS ========== -->
        <Grid Grid.Row="2">
            <!-- Indicador de carga -->
            <ActivityIndicator x:Name="loadingIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{StaticResource azulOscuro}"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             HeightRequest="50"
                             WidthRequest="50" />
            
            <CollectionView x:Name="collectionJuegos"
                            ItemsSource="{Binding listajuegos}"
                            SelectionMode="None"
                            ItemSizingStrategy="MeasureAllItems"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReached="OnRemainingItemsThresholdReached"
                            Margin="15,0,15,15">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:JuegoListCLS">
                        <Border StrokeThickness="3"
                                Stroke="{StaticResource verdeOscuro}"
                                StrokeShape="RoundRectangle 15"
                                Margin="0,5"
                                BackgroundColor="Transparent">
                                    
                            <Frame Padding="0"
                                   CornerRadius="15"
                                   HasShadow="True"
                                   BorderColor="Transparent"
                                   BackgroundColor="{Binding nombreestatusjuego, Converter={StaticResource EstatusToColor}}"
                                   Margin="0">
                                
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                                      Padding="18,18,18,22">
                                    
                                    <!-- Jornada -->
                                    <Label Grid.Row="0"
                                           Text="{Binding nombrejornada}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{Binding nombreestatusjuego, Converter={StaticResource EstatusToTextColor}}"
                                           HorizontalOptions="End"
                                           Margin="0,0,0,10" />

                                    <!-- Equipos y Marcador -->
                                    <Grid Grid.Row="1"
                                          ColumnDefinitions="2*,Auto,2*"
                                          RowDefinitions="Auto,Auto"
                                          ColumnSpacing="15"
                                          RowSpacing="10">
                                        
                                        <!-- Equipo 1 -->
                                        <Label Grid.Row="0" Grid.Column="0"
                                               Text="{Binding nombreequipo01}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               LineBreakMode="WordWrap"
                                               MaxLines="2"
                                               HorizontalOptions="FillAndExpand"
                                               HorizontalTextAlignment="End"
                                               VerticalOptions="Start"
                                               Margin="0,4,0,0"
                                               ZIndex="1" />
                                        
                                        <!-- Marcador -->
                                        <Frame Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                               Padding="15,10"
                                               CornerRadius="12"
                                               BackgroundColor="#F0F0F0"
                                               HasShadow="False"
                                               VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding golesequipo01}"
                                                       FontSize="24"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource azulOscuro}"
                                                       VerticalOptions="Center" />
                                                <Label Text="-"
                                                       FontSize="20"
                                                       FontAttributes="Bold"
                                                       TextColor="#999999"
                                                       VerticalOptions="Center" />
                                                <Label Text="{Binding golesequipo02}"
                                                       FontSize="24"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource verdeOscuro}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Frame>
                                        
                                        <!-- Equipo 2 -->
                                        <Label Grid.Row="0" Grid.Column="2"
                                               Text="{Binding nombreequipo02}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A"
                                               LineBreakMode="WordWrap"
                                               MaxLines="2"
                                               HorizontalOptions="FillAndExpand"
                                               HorizontalTextAlignment="Start"
                                               VerticalOptions="Start"
                                               Margin="0,4,0,0"
                                               ZIndex="1" />
                                    </Grid>

                                    <!-- Separador -->
                                    <BoxView Grid.Row="2"
                                             Color="#E0E0E0"
                                             HeightRequest="1"
                                             Margin="0,12" />

                                    <!-- Información adicional -->
                                    <Grid Grid.Row="3"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="10"
                                          RowSpacing="8">
                                        
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                            <Label Text="📅"
                                                   FontSize="16"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding fhorario, StringFormat='{0:dd/MM/yyyy}'}"
                                                   FontSize="13"
                                                   TextColor="#666666"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                            <Label Text="🕐"
                                                   FontSize="16"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding fhorario, StringFormat='{0:hh:mm tt}'}"
                                                   FontSize="13"
                                                   TextColor="#666666"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <Grid Grid.Row="4"
                                          ColumnDefinitions="*,Auto"
                                          Margin="0,8,0,0">
                                        
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                            <Label Text="🏟️"
                                                   FontSize="16"
                                                   VerticalOptions="Center" />
                                            <Label Text="{Binding nombrecampo}"
                                                   FontSize="13"
                                                   TextColor="#666666"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!-- Botón Ver Más -->
                                        <Button Grid.Column="1"
                                                Text="VER MÁS"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                TextColor="White"
                                                BackgroundColor="{StaticResource verdeOscuro}"
                                                CornerRadius="8"
                                                Padding="15,8"
                                                Clicked="OnVerMasClicked"
                                                CommandParameter="{Binding idjuego}">
                                            <Button.Shadow>
                                                <Shadow Brush="{StaticResource verdeOscuro}" 
                                                        Opacity="0.3" 
                                                        Radius="5" 
                                                        Offset="0,2" />
                                            </Button.Shadow>
                                        </Button>
                                    </Grid>

                                    </Grid>
                                </Frame>
                            </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center">
                        <Label Text="⚽"
                               FontSize="60"
                               HorizontalOptions="Center"
                               Opacity="0.3" />
                        <Label Text="No hay juegos programados"
                               FontSize="16"
                               TextColor="#999999"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />
                        <Label Text="Seleccione otra jornada o espere nuevos juegos"
                               FontSize="13"
                               TextColor="#CCCCCC"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,5,0,0" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="10" HorizontalOptions="Center">
                        <ActivityIndicator x:Name="footerLoadingIndicator"
                                         IsRunning="False"
                                         IsVisible="False"
                                         Color="{StaticResource verdeOscuro}"
                                         HeightRequest="30"
                                         WidthRequest="30" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </Grid>

        <!-- ========== PIE DE PÁGINA ========== -->
        <Frame Grid.Row="3"
               Padding="12"
               CornerRadius="0"
               BackgroundColor="{StaticResource verdeOscuro}"
               HasShadow="False"
               BorderColor="Transparent">
            <Label x:Name="lblTotalJuegos"
                   Text="Total de juegos: 0"
                   FontSize="12"
                   TextColor="White"
                   HorizontalOptions="Center" />
        </Frame>

    </Grid>
</ContentPage>